generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  GRUEN
  GELB
  ROT
}

enum Day {
  Montag
  Dienstag
  Mittwoch
  Donnerstag
  Freitag
}

model Task {
  id          String   @id @default(uuid())
  subject     String
  title       String
  description String?
  day         Day
  status      Status   @default(GRUEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}